from collections.abc import Iterator

from mlx import core as mx

class KVCache:
    keys: mx.array | None
    values: mx.array | None
    offset: int
    state: tuple[mx.array | None, mx.array | None]
    def __init__(self) -> None: ...
    def size(self) -> int: ...

class ArraysCache:
    cache: list[mx.array | None]
    left_padding: mx.array | None
    lengths: mx.array | None
    state: list[mx.array | None]
    def __init__(self, size: int, left_padding: list[int] | None = ...) -> None: ...
    def size(self) -> int: ...
    def trim(self, count: int) -> int: ...
    def is_trimmable(self) -> bool: ...

class CacheList:
    caches: tuple[object, ...]
    state: list[object]
    def __init__(self, *caches: object) -> None: ...
    def __iter__(self) -> Iterator[object]: ...
    def size(self) -> int: ...
    def trim(self, count: int) -> int: ...
    def is_trimmable(self) -> bool: ...
